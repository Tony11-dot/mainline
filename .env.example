# Copy to .env for local dev. On Railway, set these as service variables. Never commit real values.

# --- Core ---
PORT=8787
PUBLIC_URL=http://localhost:5173           # Railway: https://<your-app>.up.railway.app (or your domain)
DATABASE_URL=postgres://localhost:5432/mainline   # Railway: ${{Postgres.DATABASE_URL}}

# --- Secrets generated by Claude Code (see PROGRESS.md "Secrets") ---
TOKEN_ENC_KEY=                             # 32 random bytes, base64 — AES-256-GCM for Lichess tokens at rest
SESSION_SECRET=                            # 32 random bytes, base64 — HMAC for session ids
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Lichess ---
LICHESS_CLIENT_ID=mainline                 # any string; PKCE public client, no secret
LICHESS_FALLBACK_TOKEN=                    # owner's personal token (no scopes needed) — explorer for guests

# --- AI coach ---
GEMINI_API_KEY=                            # Google AI Studio key (free tier)
AI_MODEL_FAST=gemini-flash-lite-latest
AI_MODEL_LONG=gemini-flash-lite-latest
AI_DAILY_BUDGET=400                        # stay under the free-tier RPD
GROQ_API_KEY=                              # optional fallback provider
