{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MainLine",
  "version": "0.1.0",
  "identifier": "app.mainline.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @mainline/web dev",
    "beforeBuildCommand": "pnpm --filter @mainline/web build"
  },
  "app": {
    "windows": [
      {
        "title": "MainLine",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Chess opening trainer",
    "licenseFile": "../../../LICENSE",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "pgn"
        ],
        "name": "Chess PGN",
        "description": "Chess game / repertoire",
        "role": "Viewer",
        "mimeType": "application/x-chess-pgn"
      }
    ],
    "publisher": "MainLine",
    "copyright": "GPL-3.0-or-later",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQTA0M0Q5RjhEMDU5OUUKUldTZVdkRDQyVU9nLzJ3UU1sK1Q3OHRJSjNLeUUzNjdyT3p2c0VWWVBRWnBpSmhraGhpbE10SjUK",
      "endpoints": [
        "https://github.com/Tony11-dot/mainline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "mainline"
        ]
      }
    }
  }
}